# Copia este fichero a .env y rellena lo que necesites.
# Todo es opcional: sin nada configurado, el framework ya trae los datos públicos.

# --- Red y cortesía con la API ---
# Peticiones por segundo como máximo (no lo subas sin motivo).
SOFA_RATE_LIMIT=3
SOFA_TIMEOUT=15
SOFA_RETRIES=3

# Cuántas secciones se piden a la vez. 1 = de una en una.
SOFA_CONCURRENCY=4

# Cómo se hacen las peticiones: auto, curl, httpx o urllib.
# "auto" usa curl_cffi si está instalado — es el único que atraviesa el
# anti-bot de Cloudflare, porque imita el handshake TLS de Chrome y no solo
# sus cabeceras. Si ves 403 por todas partes: pip install curl_cffi
SOFA_TRANSPORT=auto

# La misma API vive en dos hosts. Si el primero contesta 403 (su anti-bot), se
# prueba el siguiente antes de rendirse. Separa varios por comas; déjalo vacío
# para no reintentar en ningún otro.
SOFA_BASE_URL=https://api.sofascore.com/api/v1
SOFA_FALLBACK_BASE_URLS=https://www.sofascore.com/api/v1

# Idioma de los textos y deporte por defecto de las búsquedas.
SOFA_LANGUAGE=es
SOFA_SPORT=football

# --- Caché ---
# Carpeta y validez (segundos) de las respuestas guardadas. 0 = sin caché.
SOFA_CACHE_DIR=.sofascore-cache
SOFA_CACHE_TTL=600
# Los partidos ya terminados no cambian: se guardan mucho más tiempo.
SOFA_CACHE_TTL_FINISHED=2592000

# Modo offline: solo lee de la caché, nunca sale a la red.
SOFA_OFFLINE=false

# --- Sofascore Plus (opcional, solo si TÚ tienes la suscripción) ---
#
# Esto NO desbloquea nada que no hayas pagado: reutiliza tu propia sesión, la
# misma que ya usa tu navegador. Son credenciales personales: no las compartas
# ni las subas a ningún repositorio (este .env está en .gitignore).
#
# Opción A: la cabecera "Cookie" copiada de tu navegador con la sesión iniciada.
SOFA_PLUS_COOKIE=
# Opción B: un token Bearer de tu cuenta.
SOFA_PLUS_TOKEN=
# Opción C: un JSON de cookies exportado por tu navegador.
SOFA_PLUS_COOKIE_FILE=
